# ── Client Environment Variables (Vercel) ─────────────────────────────────────
# Add these to your Vercel project settings → Environment Variables

# Your Render backend API URL (no trailing slash)
VITE_API_URL=https://forme-living-api.onrender.com/api

# Google OAuth Client ID (same as server)
VITE_GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com

# Paystack public key (safe to expose in browser)
VITE_PAYSTACK_PUBLIC_KEY=pk_live_...
