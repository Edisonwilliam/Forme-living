# ── Server Environment Variables ──────────────────────────────────────────────
# Copy this file to .env and fill in real values

NODE_ENV=production
PORT=10000

# Your Vercel frontend URL (no trailing slash)
CLIENT_URL=https://forme-living.vercel.app

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/forme_living?retryWrites=true&w=majority

# JWT — use a long, random string in production
JWT_SECRET=<generate-a-strong-random-secret>
JWT_EXPIRES_IN=7d

# Cookie signing secret — also use a long, random string
COOKIE_SECRET=<generate-a-strong-random-secret>

# Paystack (get from dashboard.paystack.com)
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_...

# Google OAuth
GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com

# Cloudinary (optional — for image uploads)
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# Email (e.g. SendGrid SMTP or Mailtrap for test)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_PASSWORD=<your-sendgrid-api-key>
EMAIL_FROM=concierge@formeliving.com
