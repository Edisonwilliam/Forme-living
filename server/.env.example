# Server Environment Configuration
NODE_ENV=development
PORT=5000

# Client Application URL (For CORS whitelist)
CLIENT_URL=http://localhost:5173

# Database
# Example local or MongoDB Atlas connection string:
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/forme_living?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=super_secret_jwt_forme_living_key_replace_in_production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=forme_secure_cookie_secret_change_me

# Paystack Gateway (Nigerian Payments)
PAYSTACK_SECRET_KEY=sk_test_placeholder_key_here
PAYSTACK_PUBLIC_KEY=pk_test_placeholder_key_here

# Cloudinary (Media Hosting)
CLOUDINARY_CLOUD_NAME=forme-living
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Notification Service (SMTP)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_email_user
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=concierge@formeliving.com
